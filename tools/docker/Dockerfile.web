# The image tools/build_web.sh builds the page in: perfect-dark-recomp's, which is rush-2049-recomp's (its
# tools/docker/Dockerfile, the image N64Recomp-browser's tools/publish_pages.sh builds every page in), instruction for
# instruction, so Docker's cache shares its layers. emsdk at the version N64Recomp-browser's CI uses, ninja, ccache,
# clang with lld (N64Recomp and RSPRecomp natively, and patches/ for MIPS), naga 30.0.1 (WGSL from SPIR-V; dxc comes
# with rt64) and spirv-opt.
# build_web.sh tags it with a hash of this file, so a change here makes the next run build a new one.
FROM emscripten/emsdk:6.0.12
RUN apt-get update && apt-get install -y --no-install-recommends ninja-build ccache clang lld git curl ca-certificates \
    libsdl2-dev libgtk-3-dev xz-utils unzip p7zip-full && rm -rf /var/lib/apt/lists/*
ENV CARGO_HOME=/opt/cargo RUSTUP_HOME=/opt/rustup
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal && /opt/cargo/bin/cargo install naga-cli --version 30.0.1 --locked \
    && cp /opt/cargo/bin/naga /usr/local/bin/ && rm -rf /opt/cargo/registry
# What the game forks' builds need besides: xdelta3 (GoldenEye's TLBFREE ROM), make (patches libraries), and what
# Conker's build.sh checks for before it recompiles. A layer of its own, so the ones above stay cached.
RUN apt-get update && apt-get install -y --no-install-recommends xdelta3 make pkg-config libdbus-1-dev libfreetype-dev \
    python3-venv && rm -rf /var/lib/apt/lists/*
# spirv-opt (SPIRV-Tools), which rt64 runs on a game's prebuilt shaders (RT64_PREBUILT_SHADER_LIST) before naga: their
# WGSL comes out about 45% smaller, and builds in about half the time in Chrome.
RUN apt-get update && apt-get install -y --no-install-recommends spirv-tools && rm -rf /var/lib/apt/lists/*
# The MIPS binutils, which a decompilation a game fork builds its ELF from assembles and links with (Pilotwings 64's
# build_elf.sh), and rsync, which that script calls.
RUN apt-get update && apt-get install -y --no-install-recommends binutils-mips-linux-gnu rsync && rm -rf /var/lib/apt/lists/*
# git over HTTP/1.1. Over HTTP/2, GitHub can answer this image's git (libcurl 8.5.0) a POST to git-upload-pack with
# 103 Early Hints and then 401, which fails a --filter=blob:none clone, and a lazy blob fetch in one, with "could not
# read Username" (DKR-R-web's scripts/bootstrap_dependencies.py clones that way). Over HTTP/1.1 the same clone works.
RUN git config --system http.version HTTP/1.1
